# Copy to .env.local (local) or add in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# With NO key set, the app runs in clearly labelled demo mode (rule-based, no network calls).
# Never commit .env.local — it is git-ignored.

# ── Option A (recommended): Stanford AI API Gateway ─────────────────────────────
# Key arrives by secure email after the "Add AI API Gateway Key" request is approved by the PTA owner.
STANFORD_AI_API_KEY=
# Must exactly match a model alias enabled on your key (check with: npm run check:ai)
STANFORD_AI_MODEL=claude-haiku-4-5
# STANFORD_AI_BASE_URL=https://aiapi-prod.stanford.edu/v1

# ── Option B: Anthropic directly ────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Option C: any OpenAI-compatible Chat Completions API ────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional app-side daily caps (soft guard; the gateway's monthly budget is the hard limit).
# When reached, AI features fall back to labelled demo responses until midnight UTC.
# AI_DAILY_REQUEST_LIMIT=300
# AI_DAILY_TOKEN_LIMIT=500000

# Optional
# LLM_TIMEOUT_MS=45000   # the gateway can take 20–30 s per request
# DEMO_ONLY=1            # force demo mode even if a key is present
